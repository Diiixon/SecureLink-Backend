# Production environment variables for SecureLink-React
# These URLs will be used when building for production (npm run build)

# Auth Service URL - Replace with your EC2 public DNS or Elastic IP
# Example: http://ec2-xx-xxx-xxx-xx.compute-1.amazonaws.com:8080
# Or with domain: https://auth.tudominio.com
VITE_AUTH_URL=http://54.147.108.252:8080

# Analysis Service URL - Replace with your EC2 public DNS or Elastic IP
# Example: http://ec2-yy-yyy-yyy-yy.compute-1.amazonaws.com:8081
# Or with domain: https://api.tudominio.com
VITE_ANALYSIS_URL=http://54.144.201.173:8081
